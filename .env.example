# SALIN sebagai variables di Railway (Service > Variables). JANGAN commit file .env asli.
BACUS_DATA=/data
BACUS_HTTPS=1
BACUS_SECRET_KEY=            # python -c "import secrets;print(secrets.token_hex(32))"
BACUS_PHOTO_KEY=             # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BACUS_ADMIN_USER=            # contoh: owner_bacus
BACUS_ADMIN_PASSWORD=        # min. 12 karakter; hapus setelah login pertama berhasil
BACUS_ADMIN_WA=              # contoh: 08xxxxxxxxxx
# BACUS_ADMIN_RESET=1        # hanya jika lupa password admin; hapus lagi setelah berhasil
